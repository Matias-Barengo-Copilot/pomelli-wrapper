# Anthropic
ANTHROPIC_API_KEY=

# Render / Production
# Generate with:  node -e "process.stdout.write(require('fs').readFileSync('google-session.json').toString('base64'))"
GOOGLE_SESSION_B64=

# Docker container
CONTAINER_NAME=pomelli-computer
DISPLAY_WIDTH=1280
DISPLAY_HEIGHT=800
MAX_ITERATIONS=200
OUTPUTS_DIR=outputs

# Supabase (server-side — CLI y GitHub Actions)
# Obtener en: Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SECRET_KEY=        # sb_secret_... — nunca exponer al cliente

# Supabase Storage
SUPABASE_BUCKET=runs

# Modo GitHub Actions
# BRAND_URL=                # URL de la marca a procesar (reemplaza --url en Actions)
# RUN_ID=                   # ID del run generado por la web app
# HEADLESS_MODE=true        # Saltea VNC en entornos sin display

# Firefox profile encryption (GitHub Actions)
# FIREFOX_PROFILE_KEY=      # String aleatorio 32+ chars para encriptar el profile
