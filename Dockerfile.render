FROM node:20-slim

ENV DEBIAN_FRONTEND=noninteractive
# Store Playwright browsers inside the app so they survive the layer cache
ENV PLAYWRIGHT_BROWSERS_PATH=/app/.playwright

WORKDIR /app

# Install all deps (devDeps needed for tsx, playwright, vite)
COPY package*.json ./
RUN npm ci

# Install Chromium + OS dependencies in one layer
RUN npx playwright install chromium --with-deps

# Copy source and build the React client
COPY . .
RUN npm run client:build

EXPOSE 3000

CMD ["npx", "tsx", "src/server.ts"]
